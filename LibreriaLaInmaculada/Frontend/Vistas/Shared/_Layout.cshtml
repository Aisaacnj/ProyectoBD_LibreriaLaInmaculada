@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var accion = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

    // ¿Esta opción del menú es la página actual?
    bool EsActual(string c, string? a = null) =>
        string.Equals(controlador, c, StringComparison.OrdinalIgnoreCase) &&
        (a == null || string.Equals(accion, a, StringComparison.OrdinalIgnoreCase));

    string Clase(bool actual) => actual ? "menu-item activo" : "menu-item";
    string? Aria(bool actual) => actual ? "page" : null;

    var esAdmin = User.EsAdministrador();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Librería La Inmaculada</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body class="fondo-puntos">
    <div class="app">
        <nav class="menu" aria-label="Menú principal">
            <div class="menu-marca">
                <div class="menu-logo">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Logo" /></svg>
                </div>
                <div>
                    <span class="menu-nombre">La Inmaculada</span>
                    <span class="menu-sub">Librería escolar</span>
                </div>
            </div>

            <div class="menu-lista">
                @* Opciones para todos los usuarios *@
                <a class="@Clase(EsActual("Home"))" aria-current="@Aria(EsActual("Home"))" asp-controller="Home" asp-action="Index">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Inicio" /></svg><span>Inicio</span>
                </a>
                <a class="@Clase(EsActual("Ventas", "Nueva"))" aria-current="@Aria(EsActual("Ventas", "Nueva"))" asp-controller="Ventas" asp-action="Nueva">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Vender" /></svg><span>Vender</span>
                </a>
                <a class="@Clase(EsActual("Ventas") && !EsActual("Ventas", "Nueva"))" aria-current="@Aria(EsActual("Ventas") && !EsActual("Ventas", "Nueva"))" asp-controller="Ventas" asp-action="Index">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Ventas" /></svg><span>@(esAdmin ? "Ventas" : "Mis ventas")</span>
                </a>
                <a class="@Clase(EsActual("Inventario"))" aria-current="@Aria(EsActual("Inventario"))" asp-controller="Inventario" asp-action="Index">
                    <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Inventario" /></svg><span>Inventario</span>
                </a>

                @* Opciones solo para el Administrador: al vendedor ni siquiera se le muestran *@
                @if (esAdmin)
                {
                    <a class="@Clase(EsActual("Compras"))" aria-current="@Aria(EsActual("Compras"))" asp-controller="Compras" asp-action="Index">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Compras" /></svg><span>Compras</span>
                    </a>
                    <a class="@Clase(EsActual("Perdidas"))" aria-current="@Aria(EsActual("Perdidas"))" asp-controller="Perdidas" asp-action="Index">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Perdidas" /></svg><span>Pérdidas</span>
                    </a>
                    <a class="@Clase(EsActual("Proveedores"))" aria-current="@Aria(EsActual("Proveedores"))" asp-controller="Proveedores" asp-action="Index">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Proveedores" /></svg><span>Proveedores</span>
                    </a>
                    <a class="@Clase(EsActual("Reportes"))" aria-current="@Aria(EsActual("Reportes"))" asp-controller="Reportes" asp-action="Index">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Reportes" /></svg><span>Reportes</span>
                    </a>
                    <a class="@Clase(EsActual("Usuarios"))" aria-current="@Aria(EsActual("Usuarios"))" asp-controller="Usuarios" asp-action="Index">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Usuarios" /></svg><span>Usuarios</span>
                    </a>
                }
            </div>

            <div class="menu-usuario">
                <div class="avatar @(esAdmin ? "avatar-admin" : "")">@User.Iniciales()</div>
                <div class="menu-usuario-datos">
                    <span class="menu-usuario-nombre">@User.NombreCompleto()</span>
                    <span class="menu-usuario-rol">@User.Rol()</span>
                </div>
                <form method="post" asp-controller="Cuenta" asp-action="Salir">
                    <button type="submit" class="boton-icono" aria-label="Cerrar sesión" title="Cerrar sesión">
                        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Salir" /></svg>
                    </button>
                </form>
            </div>
        </nav>

        <main class="contenido">
            <header class="banner">
                <partial name="_Decoracion" />
                <div class="banner-texto">
                    <span class="banner-fecha">@(ViewData["Subtitulo"] ?? Formato.FechaLarga(DateTime.Today))</span>
                    <h1>@ViewData["Title"]</h1>
                    @if (ViewData["Descripcion"] is string descripcion)
                    {
                        <p>@descripcion</p>
                    }
                </div>
                @await RenderSectionAsync("BannerDerecha", required: false)
            </header>

            <partial name="_Mensajes" />

            @RenderBody()
        </main>
    </div>
    <partial name="_ScriptsValidacion" />
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
