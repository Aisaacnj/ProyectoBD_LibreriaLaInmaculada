@model UsuarioPasswordViewModel
@{
    ViewData["Title"] = "Cambiar contraseña";
    ViewData["Descripcion"] = $"Nueva contraseña para «{Model.Usuario}». La anterior deja de funcionar al guardar.";
}

@section BannerDerecha {
    <a class="banner-accion secundaria" asp-action="Index">
        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Volver" /></svg>
        Volver a usuarios
    </a>
}

<section class="tarjeta formulario-tarjeta">
    <form method="post" asp-action="Password" class="formulario" autocomplete="off">
        <input type="hidden" asp-for="IdUsuario" />
        <div asp-validation-summary="ModelOnly" class="mensaje-error" role="alert"></div>

        <div class="formulario-grid">
            <div class="campo">
                <label asp-for="Password"></label>
                <input asp-for="Password" autocomplete="new-password" autofocus />
                <span class="ayuda">Al menos 8 caracteres.</span>
                <span asp-validation-for="Password" class="error-campo"></span>
            </div>
            <div class="campo">
                <label asp-for="ConfirmarPassword"></label>
                <input asp-for="ConfirmarPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmarPassword" class="error-campo"></span>
            </div>
        </div>

        <div class="formulario-botones">
            <button type="submit" class="boton boton-principal">
                <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Candado" /></svg>
                Guardar contraseña
            </button>
            <a class="boton boton-secundario" asp-action="Index">Cancelar</a>
        </div>
    </form>
</section>
