@model InicioVendedorViewModel
@{
    var nombre = User.NombreCompleto().Split(' ')[0];
    ViewData["Title"] = $"Hola, {nombre}";
    ViewData["Descripcion"] = "Este es su resumen del día.";
}

@section BannerDerecha {
    <a class="banner-accion" asp-controller="Ventas" asp-action="Nueva">
        <svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Vender" /></svg>
        Nueva venta
    </a>
}

<div class="kpis">
    <div class="tarjeta kpi">
        <div class="kpi-icono indigo"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Ventas" /></svg></div>
        <span class="kpi-titulo">Sus ventas de hoy</span>
        <span class="kpi-valor">@Model.VentasHoy</span>
    </div>
    <div class="tarjeta kpi">
        <div class="kpi-icono azul"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Dinero" /></svg></div>
        <span class="kpi-titulo">Cobrado hoy</span>
        <span class="kpi-valor">@Formato.Cordobas(Model.VendidoHoy)</span>
    </div>
    <div class="tarjeta kpi">
        <div class="kpi-icono ambar"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Alerta" /></svg></div>
        <span class="kpi-titulo">Se están acabando</span>
        <span class="kpi-valor">@Model.PorReabastecer.Count @(Model.PorReabastecer.Count == 1 ? "artículo" : "artículos")</span>
    </div>
</div>

<div class="fila">
    <section class="tarjeta crece" aria-labelledby="titulo-ultimas">
        <h2 id="titulo-ultimas">Sus últimas ventas</h2>
        @if (Model.UltimasVentas.Count == 0)
        {
            <p class="texto-suave">Todavía no ha registrado ventas.</p>
        }
        else
        {
            <div class="tabla-caja">
                <table class="tabla">
                    <thead>
                        <tr><th>Venta</th><th>Fecha</th><th class="derecha">Total</th><th>Estado</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var v in Model.UltimasVentas)
                        {
                            <tr>
                                <td>#@v.IdVenta</td>
                                <td>@Formato.FechaHora(v.Fecha)</td>
                                <td class="derecha fuerte">@Formato.Cordobas(v.Total)</td>
                                <td><span class="etiqueta @(v.Estado == "Activa" ? "ok" : "anulada")">@v.Estado</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </section>

    <div class="columna-lateral">
        <section class="tarjeta" aria-labelledby="titulo-reabastecer">
            <h2 id="titulo-reabastecer">Se están acabando</h2>
            <p class="texto-suave">Avise a los dueños para que los compren.</p>
            @if (Model.PorReabastecer.Count == 0)
            {
                <p class="texto-suave">Todos los artículos tienen stock suficiente.</p>
            }
            @foreach (var a in Model.PorReabastecer)
            {
                <div class="alerta-stock @(a.Agotado ? "agotado" : "bajo")">
                    <span class="alerta-nombre">@a.Descripcion</span>
                    <span class="alerta-dato">@(a.Agotado ? "Agotado" : $"Quedan {a.Stock}")</span>
                </div>
            }
        </section>
    </div>
</div>
