@model InicioAdminViewModel
@{
    var hora = DateTime.Now.Hour;
    ViewData["Title"] = hora < 12 ? "Buenos días" : (hora < 18 ? "Buenas tardes" : "Buenas noches");
    var mes = Formato.Mes(Model.MesReferencia.Month);
    ViewData["Descripcion"] = $"Así le va a la librería en {mes} de {Model.MesReferencia.Year}.";

    decimal maximo = Model.VentasPorMes.Count > 0 ? Model.VentasPorMes.Max(v => v.Total) : 0;
    int mesMayor = Model.VentasPorMes.Count > 0 && maximo > 0
        ? Model.VentasPorMes.First(v => v.Total == maximo).Mes : 0;
    int unidadesMax = Model.MasVendidos.Count > 0 ? Model.MasVendidos.Max(t => t.Unidades) : 0;
}

<div class="kpis">
    <div class="tarjeta kpi">
        <div class="kpi-icono azul"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Dinero" /></svg></div>
        <span class="kpi-titulo">Vendido en @mes</span>
        <span class="kpi-valor">@Formato.CordobasRedondo(Model.VendidoMes)</span>
    </div>
    <div class="tarjeta kpi">
        <div class="kpi-icono verde"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Subida" /></svg></div>
        <span class="kpi-titulo">Ganancia de @mes</span>
        <span class="kpi-valor">@Formato.CordobasRedondo(Model.GananciaMes)</span>
    </div>
    <div class="tarjeta kpi">
        <div class="kpi-icono indigo"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Ventas" /></svg></div>
        <span class="kpi-titulo">Ventas en @mes</span>
        <span class="kpi-valor">@Model.VentasMes.ToString("N0")</span>
    </div>
    <div class="tarjeta kpi">
        <div class="kpi-icono ambar"><svg class="icono" viewBox="0 0 24 24" aria-hidden="true"><path d="@Iconos.Alerta" /></svg></div>
        <span class="kpi-titulo">Por reabastecer</span>
        <span class="kpi-valor">@Model.PorReabastecer.Count @(Model.PorReabastecer.Count == 1 ? "artículo" : "artículos")</span>
    </div>
</div>

<div class="fila">
    <section class="tarjeta grafica" aria-labelledby="titulo-grafica">
        <h2 id="titulo-grafica">
            @(mesMayor > 0 ? $"{char.ToUpper(Formato.Mes(mesMayor)[0])}{Formato.Mes(mesMayor)[1..]} es el mes que más se ha vendido" : "Ventas por mes")
        </h2>
        <p class="texto-suave">Ventas por mes en @Model.MesReferencia.Year (C$, solo ventas activas).</p>

        @if (maximo > 0)
        {
            <div class="barras" role="img" aria-label="Gráfico de barras de ventas por mes">
                @foreach (var v in Model.VentasPorMes)
                {
                    var alto = (double)(v.Total / maximo) * 170;
                    var clase = v.Mes == mesMayor ? "barra destacada" : (v.Mes == Model.MesReferencia.Month ? "barra actual" : "barra");
                    <div class="barra-columna">
                        <span class="barra-valor">@((v.Total / 1000m).ToString("0.0"))k</span>
                        <div class="@clase" style="height: @(Formato.Css(alto))px"></div>
                        <span class="barra-mes">@Formato.MesCorto(v.Mes)</span>
                    </div>
                }
            </div>
        }
        else
        {
            <p class="texto-suave">Todavía no hay ventas registradas este año.</p>
        }
    </section>

    <div class="columna-lateral">
        <section class="tarjeta" aria-labelledby="titulo-reabastecer">
            <h2 id="titulo-reabastecer">Por reabastecer</h2>
            @if (Model.PorReabastecer.Count == 0)
            {
                <p class="texto-suave">Todos los artículos tienen stock suficiente.</p>
            }
            @foreach (var a in Model.PorReabastecer)
            {
                <div class="alerta-stock @(a.Agotado ? "agotado" : "bajo")">
                    <span class="alerta-nombre">@a.Descripcion</span>
                    <span class="alerta-dato">@(a.Agotado ? "Agotado" : $"Quedan {a.Stock}") · mín. @a.StockMinimo</span>
                </div>
            }
            <a asp-controller="Compras" asp-action="Index">Registrar una compra</a>
        </section>

        <section class="tarjeta" aria-labelledby="titulo-top">
            <h2 id="titulo-top">Más vendidos del año (unidades)</h2>
            @foreach (var t in Model.MasVendidos)
            {
                var ancho = unidadesMax > 0 ? (double)t.Unidades / unidadesMax * 100 : 0;
                <div class="top-item">
                    <div class="top-linea">
                        <span>@t.Nombre</span>
                        <strong>@t.Unidades.ToString("N0")</strong>
                    </div>
                    <div class="top-pista"><div class="top-relleno" style="width: @(Formato.Css(ancho))%"></div></div>
                </div>
            }
        </section>
    </div>
</div>
