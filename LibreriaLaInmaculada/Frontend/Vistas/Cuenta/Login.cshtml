@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutLogin";
}
<main class="login">
    <section class="login-portada" aria-hidden="true">
        <partial name="_Decoracion" />
        <div class="login-portada-texto">
            <div class="menu-logo grande">
                <svg class="icono" viewBox="0 0 24 24"><path d="@Iconos.Logo" /></svg>
            </div>
            <span class="login-titulo">Librería La Inmaculada</span>
            <span class="login-lema">Inventario y facturación de la librería escolar</span>
        </div>
    </section>

    <section class="login-tarjeta">
        <h1>Iniciar sesión</h1>
        <p class="texto-suave">Escriba su usuario y contraseña para entrar al sistema.</p>

        <form method="post" asp-action="Login" class="formulario">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="mensaje-error" role="alert"></div>

            <div class="campo">
                <label asp-for="Usuario">Usuario</label>
                <input asp-for="Usuario" autocomplete="username" autofocus />
                <span asp-validation-for="Usuario" class="error-campo"></span>
            </div>
            <div class="campo">
                <label asp-for="Password">Contraseña</label>
                <input asp-for="Password" autocomplete="current-password" />
                <span asp-validation-for="Password" class="error-campo"></span>
            </div>

            <button type="submit" class="boton boton-principal">Entrar</button>
        </form>
    </section>
</main>
