<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LibreriaLaInmaculada</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- ADO.NET para SQL Server -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Archivos públicos del Frontend (css, imágenes): se copian al publicar -->
    <None Remove="Frontend\wwwroot\**" />
    <Content Include="Frontend\wwwroot\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
